{
  "name": "@tokenforge/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/contracts.test.ts test/crypto.test.ts test/token-verifier.test.ts test/http-auth.test.ts test/replay-store.test.ts test/worker-lease.test.ts",
    "test:bundle": "node --test test/token-verifier-bundle.test.ts",
    "test:replay": "node --test test/replay-redis.test.ts",
    "test:redis-adapter": "node scripts/test-redis-adapter.mjs",
    "build": "node scripts/build.mjs",
    "audit:dependencies": "npm audit --omit=dev"
  },
  "dependencies": {
    "@cloudflare/privacypass-ts": "0.9.0",
    "ioredis": "6.0.0"
  },
  "overrides": {
    "@cloudflare/blindrsa-ts": {
      "sjcl": "1.0.9"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
