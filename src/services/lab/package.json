{
  "name": "@tokenforge/lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/fixture.test.ts test/crypto.test.ts test/controller-contract.test.ts test/issuer.test.ts test/issuer-control.test.ts test/control-server.test.ts test/client.test.ts",
    "build": "node scripts/build.mjs",
    "test:bundle": "node --test test/bundle.test.ts",
    "audit:dependencies": "npm audit --omit=dev"
  },
  "dependencies": {
    "@cloudflare/privacypass-ts": "0.9.0"
  },
  "overrides": {
    "@cloudflare/blindrsa-ts": { "sjcl": "1.0.9" }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
