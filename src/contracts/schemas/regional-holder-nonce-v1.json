{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tokenforge.invalid/contracts/regional-holder-nonce-v1.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "TF-PS024-REGIONAL-1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "policy_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "token_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "holder_key_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "random_b64url": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "policy_digest",
    "token_hash",
    "holder_key_hash",
    "issued_ms",
    "expires_ms",
    "random_b64url"
  ],
  "additionalProperties": false
}
